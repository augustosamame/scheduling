<!DOCTYPE html>
<html>
  <head>
    <title>Scheduling Admin - <%= content_for?(:title) ? yield(:title) : "Dashboard" %></title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Tailwind CSS via CDN -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Stimulus via CDN -->
    <script type="module">
      import { Application, Controller } from "https://cdn.jsdelivr.net/npm/@hotwired/stimulus@3.2.2/+esm"

      window.Stimulus = Application.start()

      // Date Filters Controller
      class DateFiltersController extends Controller {
        static targets = ["fromDate", "toDate", "form"]

        connect() {
          console.log("🎯 DateFilters controller connected!")
          console.log("Form target:", this.formTarget)
          console.log("FromDate target:", this.fromDateTarget)
          console.log("ToDate target:", this.toDateTarget)
        }

        setActiveButton(button) {
          // Remove active state from all date pill buttons
          this.element.querySelectorAll('[data-date-pill]').forEach(btn => {
            btn.classList.remove('!bg-blue-600', '!text-white', '!border-blue-600')
            btn.classList.add('text-blue-700', 'bg-white', 'border-blue-300')
          })

          // Add active state to clicked button
          button.classList.remove('text-blue-700', 'bg-white', 'border-blue-300')
          button.classList.add('!bg-blue-600', '!text-white', '!border-blue-600')
        }

        setToday(event) {
          console.log("📅 setToday clicked!")
          event.preventDefault()
          this.setActiveButton(event.currentTarget)

          const today = new Date()
          const todayStr = today.toISOString().split('T')[0]
          console.log("Setting dates to:", todayStr)

          this.fromDateTarget.value = todayStr
          this.toDateTarget.value = todayStr
          this.submitForm()
        }

        setTomorrow(event) {
          console.log("📅 setTomorrow clicked!")
          event.preventDefault()
          this.setActiveButton(event.currentTarget)

          const today = new Date()
          const tomorrow = new Date(today)
          tomorrow.setDate(today.getDate() + 1)
          const tomorrowStr = tomorrow.toISOString().split('T')[0]
          console.log("Setting dates to:", tomorrowStr)

          this.fromDateTarget.value = tomorrowStr
          this.toDateTarget.value = tomorrowStr
          this.submitForm()
        }

        setThisWeek(event) {
          console.log("📅 setThisWeek clicked!")
          event.preventDefault()
          this.setActiveButton(event.currentTarget)

          const today = new Date()
          const monday = new Date(today)
          monday.setDate(today.getDate() - today.getDay() + 1)
          const sunday = new Date(monday)
          sunday.setDate(monday.getDate() + 6)
          console.log("Setting dates from:", monday.toISOString().split('T')[0], "to:", sunday.toISOString().split('T')[0])

          this.fromDateTarget.value = monday.toISOString().split('T')[0]
          this.toDateTarget.value = sunday.toISOString().split('T')[0]
          this.submitForm()
        }

        setNextWeek(event) {
          console.log("📅 setNextWeek clicked!")
          event.preventDefault()
          this.setActiveButton(event.currentTarget)

          const today = new Date()
          const nextMonday = new Date(today)
          nextMonday.setDate(today.getDate() - today.getDay() + 8)
          const nextSunday = new Date(nextMonday)
          nextSunday.setDate(nextMonday.getDate() + 6)
          console.log("Setting dates from:", nextMonday.toISOString().split('T')[0], "to:", nextSunday.toISOString().split('T')[0])

          this.fromDateTarget.value = nextMonday.toISOString().split('T')[0]
          this.toDateTarget.value = nextSunday.toISOString().split('T')[0]
          this.submitForm()
        }

        submitForm() {
          console.log("📤 Submitting form...")
          if (this.hasFormTarget) {
            console.log("✅ Form target found, submitting...")
            this.showLoader()
            this.formTarget.submit()
          } else {
            console.error("❌ No form target found!")
          }
        }

        showLoader() {
          const loader = document.getElementById('loading-overlay')
          if (loader) {
            loader.classList.remove('hidden')
          }
        }
      }

      // Register the controller
      Stimulus.register("scheduling--date-filters", DateFiltersController)
      console.log("✅ Stimulus loaded and DateFilters controller registered!")
    </script>

    <%= yield :head %>
  </head>

  <body class="bg-gray-50">
    <!-- Navigation -->
    <nav class="bg-white shadow-sm border-b border-gray-200">
      <div class="px-4 mx-auto max-w-7xl sm:px-6 lg:px-8">
        <div class="flex justify-between h-16">
          <!-- Logo and main nav -->
          <div class="flex">
            <div class="flex items-center flex-shrink-0">
              <h1 class="text-xl font-bold text-gray-900">📅 Scheduling Admin</h1>
            </div>

            <div class="hidden sm:ml-6 sm:flex sm:space-x-8">
              <%= link_to t('scheduling.admin.nav.dashboard'), admin_root_path, class: "inline-flex items-center px-1 pt-1 text-sm font-medium #{current_page?(admin_root_path) ? 'border-b-2 border-blue-500 text-gray-900' : 'text-gray-500 hover:text-gray-700'}" %>
              <%= link_to t('scheduling.admin.nav.event_types'), admin_event_types_path, class: "inline-flex items-center px-1 pt-1 text-sm font-medium #{current_page?(admin_event_types_path) ? 'border-b-2 border-blue-500 text-gray-900' : 'text-gray-500 hover:text-gray-700'}" %>
            </div>
          </div>

          <!-- User menu -->
          <div class="flex items-center space-x-4">
            <!-- Language Switcher -->
            <div class="flex space-x-2">
              <%= link_to "ES", url_for(params.permit!.merge(locale: :es)), class: "px-3 py-1 text-xs font-semibold rounded #{I18n.locale == :es ? 'bg-blue-600 text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300'}" %>
              <%= link_to "EN", url_for(params.permit!.merge(locale: :en)), class: "px-3 py-1 text-xs font-semibold rounded #{I18n.locale == :en ? 'bg-blue-600 text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300'}" %>
            </div>

            <!-- User Info -->
            <span class="text-sm text-gray-700">
              <%= @current_member.full_name %>
              <span class="px-2 py-1 ml-2 text-xs font-semibold text-blue-800 bg-blue-100 rounded-full">
                <%= @current_member.role.titleize %>
              </span>
            </span>
          </div>
        </div>
      </div>
    </nav>

    <!-- Flash messages -->
    <% if flash.any? %>
      <div class="px-4 py-3 mx-auto max-w-7xl sm:px-6 lg:px-8">
        <% flash.each do |type, message| %>
          <div class="p-4 mb-4 rounded-lg <%= type == 'notice' ? 'bg-green-50 border border-green-200 text-green-800' : 'bg-red-50 border border-red-200 text-red-800' %>">
            <%= message %>
          </div>
        <% end %>
      </div>
    <% end %>

    <!-- Main content -->
    <main class="px-4 py-6 mx-auto max-w-7xl sm:px-6 lg:px-8">
      <%= yield %>
    </main>
  </body>
</html>
