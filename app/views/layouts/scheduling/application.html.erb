<% config = Scheduling.configuration %>
<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= content_for?(:title) ? "#{yield(:title)} - #{config.company_name}" : config.company_name %></title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <!-- Tailwind CSS CDN (for quick start - replace with proper asset pipeline in production) -->
  <script src="https://cdn.tailwindcss.com"></script>

  <style>
    :root {
      --primary-color: <%= config.primary_color %>;
      --secondary-color: <%= config.secondary_color %>;
      --font-family: <%= config.font_family %>;
    }

    body {
      font-family: var(--font-family);
    }

    .btn-primary {
      background-color: var(--primary-color);
    }

    .btn-primary:hover {
      opacity: 0.9;
    }

    .text-primary {
      color: var(--primary-color);
    }

    .border-primary {
      border-color: var(--primary-color);
    }

    .bg-primary {
      background-color: var(--primary-color);
    }

    .bg-primary-50 {
      background-color: <%= config.primary_color %>10;
    }
  </style>

  <%= yield :head %>
  <%= stylesheet_link_tag "scheduling/application", media: "all" %>
</head>
<body class="flex flex-col min-h-screen bg-gray-50">
  <!-- Header -->
  <header class="bg-white shadow-sm">
    <div class="px-4 py-4 mx-auto max-w-7xl sm:px-6 lg:px-8">
      <div class="flex justify-between items-center">
        <div class="flex items-center gap-2">
          <% if config.logo_url.present? %>
            <%= image_tag config.logo_url, alt: config.company_name, class: "h-10 w-auto" %>
          <% end %>

          <!-- Breadcrumb Navigation -->
          <div class="flex items-center gap-2 text-lg">
            <% if defined?(@organization) && @organization.present? %>
              <!-- Organization Name (always clickable if present) -->
              <%= link_to @organization.name,
                         organization_booking_path(organization_slug: @organization.slug, locale: I18n.locale),
                         class: "font-bold text-primary hover:underline" %>

              <% if defined?(@member) && @member.present? %>
                <!-- Separator -->
                <span class="text-gray-400">/</span>

                <!-- Member Name (clickable to their booking page) -->
                <%= link_to @member.full_name,
                           member_booking_path(organization_slug: @organization.slug, booking_slug: @member.booking_slug, locale: I18n.locale),
                           class: "font-semibold text-gray-700 hover:text-primary hover:underline" %>
              <% end %>
            <% else %>
              <!-- Fallback to company name if no organization context -->
              <h1 class="font-bold text-primary">
                <%= config.company_name %>
              </h1>
            <% end %>
          </div>
        </div>

        <% if I18n.available_locales.size > 1 %>
          <div class="flex items-center space-x-2">
            <% I18n.available_locales.each do |locale| %>
              <%= link_to locale.to_s.upcase,
                         url_for(locale: locale),
                         class: "px-2 py-1 text-sm #{I18n.locale == locale ? 'text-primary font-semibold' : 'text-gray-600 hover:text-gray-900'}" %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </header>

  <!-- Flash Messages -->
  <% if flash.any? %>
    <div class="px-4 mx-auto mt-4 max-w-7xl sm:px-6 lg:px-8">
      <% flash.each do |type, message| %>
        <div class="rounded-md p-4 mb-4 <%= type == 'notice' ? 'bg-green-50 text-green-800' : 'bg-red-50 text-red-800' %>">
          <p><%= message %></p>
        </div>
      <% end %>
    </div>
  <% end %>

  <!-- Main Content -->
  <main class="flex-1 py-8">
    <%= yield %>
  </main>

  <!-- Footer -->
  <footer class="mt-auto bg-white border-t border-gray-200">
    <div class="px-4 py-6 mx-auto max-w-7xl sm:px-6 lg:px-8">
      <div class="text-sm text-center text-gray-500">
        <p>&copy; <%= Time.current.year %> <%= config.company_name %>. All rights reserved.</p>
        <p class="mt-1">Powered by DevtechPeru.com Scheduling Engine</p>
      </div>
    </div>
  </footer>
</body>
</html>
