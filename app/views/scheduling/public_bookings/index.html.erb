<% content_for :title, "Book with #{@member.full_name}" %>

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
  <!-- Member Info -->
  <div class="bg-gradient-to-br from-white to-gray-50 rounded-xl shadow-sm border border-gray-100 p-8 mb-8">
    <div class="flex items-start">
      <div class="flex-1">
        <h1 class="text-4xl font-bold text-gray-900 mb-2">
          <%= @member.full_name %>
        </h1>

        <% if @member.title.present? %>
          <p class="text-xl text-gray-600 mb-4">
            <%= @member.title %>
          </p>
        <% end %>

        <% if @member.bio.present? %>
          <p class="text-gray-700 text-lg leading-relaxed">
            <%= @member.bio %>
          </p>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Event Types -->
  <div class="space-y-4">
    <h2 class="text-2xl font-bold text-gray-900 mb-6">
      Available Appointment Types
    </h2>

    <% if @event_types.any? %>
      <% @event_types.each do |event_type| %>
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 hover:shadow-lg hover:border-blue-300 transition-all duration-200">
          <%= link_to new_booking_path(@organization.slug, @member.booking_slug, event_type.slug),
                     class: "block p-6 group" do %>
            <div class="flex justify-between items-start gap-6">
              <div class="flex-1">
                <h3 class="text-2xl font-bold text-gray-900 group-hover:text-blue-600 transition-colors mb-2">
                  <%= event_type.title %>
                </h3>

                <% if event_type.description.present? %>
                  <p class="text-gray-600 text-base mb-4">
                    <%= event_type.description %>
                  </p>
                <% end %>

                <div class="flex flex-wrap gap-6 text-sm">
                  <!-- Duration -->
                  <div class="flex items-center text-gray-600">
                    <svg class="w-5 h-5 mr-2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <span class="font-medium"><%= event_type.duration_minutes %> min</span>
                  </div>

                  <!-- Location Type -->
                  <% if event_type.location_type.present? %>
                    <div class="flex items-center text-gray-600">
                      <svg class="w-5 h-5 mr-2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                      </svg>
                      <span class="font-medium"><%= event_type.location_type.titleize %></span>
                    </div>
                  <% end %>

                  <!-- Price - Prominent -->
                  <% if event_type.price_cents > 0 %>
                    <div class="flex items-center text-blue-600">
                      <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                      </svg>
                      <span class="text-2xl font-bold"><%= number_to_currency(event_type.price_cents / 100.0, unit: event_type.price_currency) %></span>
                    </div>
                  <% else %>
                    <div class="flex items-center">
                      <span class="px-3 py-1 bg-green-100 text-green-700 rounded-full text-sm font-bold">FREE</span>
                    </div>
                  <% end %>
                </div>
              </div>

              <div class="flex-shrink-0">
                <span class="inline-flex items-center px-6 py-3 bg-blue-600 text-white text-base font-semibold rounded-lg group-hover:bg-blue-700 transition-colors shadow-sm">
                  Book Now
                  <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                  </svg>
                </span>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-6 text-center">
        <p class="text-yellow-800">
          No appointment types are currently available. Please check back later.
        </p>
      </div>
    <% end %>
  </div>
</div>
