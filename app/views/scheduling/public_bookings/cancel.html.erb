<% content_for :title, t('scheduling.bookings.cancel.title') %>

<div class="px-4 mx-auto max-w-2xl sm:px-6 lg:px-8">
  <!-- Booking Details -->
  <div class="p-6 mb-6 bg-white rounded-lg shadow-sm">
    <h2 class="mb-4 text-2xl font-bold text-gray-900">
      <%= t('scheduling.bookings.cancel.title') %>
    </h2>

    <div class="p-4 mb-6 bg-yellow-50 rounded-lg border border-yellow-200">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="w-5 h-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
          </svg>
        </div>
        <div class="ml-3">
          <p class="text-sm text-yellow-800">
            <%= t('scheduling.bookings.cancel.warning_message') %>
          </p>
        </div>
      </div>
    </div>

    <div class="mb-6 space-y-3">
      <div>
        <p class="text-sm font-medium text-gray-500"><%= t('scheduling.bookings.cancel.appointment') %></p>
        <p class="mt-1 text-gray-900"><%= @booking.event_type.title %></p>
      </div>

      <div>
        <p class="text-sm font-medium text-gray-500"><%= t('scheduling.bookings.cancel.with') %></p>
        <p class="mt-1 text-gray-900"><%= @booking.member.full_name %></p>
      </div>

      <div>
        <p class="text-sm font-medium text-gray-500"><%= t('scheduling.bookings.cancel.scheduled_for') %></p>
        <p class="mt-1 font-semibold text-gray-900">
          <%= l(@booking.start_time.in_time_zone(@booking.timezone), format: :long) %>
        </p>
      </div>
    </div>

    <%= form_with url: process_cancel_booking_path(@booking.cancellation_token),
                 method: :post,
                 local: true do |f| %>
      <div class="mb-6">
        <label class="block mb-2 text-sm font-medium text-gray-700">
          <%= t('scheduling.bookings.cancel.reason') %>
        </label>
        <%= text_area_tag :reason,
                         nil,
                         rows: 3,
                         placeholder: t('scheduling.bookings.cancel.reason_placeholder'),
                         class: "w-full rounded-md border-gray-300 shadow-sm focus:border-primary focus:ring-primary" %>
      </div>

      <div class="flex justify-between items-center pt-4 border-t">
        <%= link_to t('scheduling.bookings.cancel.keep_appointment'),
                   booking_confirmation_path(@booking.uid),
                   class: "text-gray-600 hover:text-gray-900" %>

        <%= f.submit t('scheduling.bookings.cancel.cancel_appointment'),
                   data: { confirm: t('scheduling.bookings.cancel.confirm') },
                   class: "px-6 py-2 bg-red-600 text-white font-semibold rounded-md hover:bg-red-700 transition-colors cursor-pointer" %>
      </div>
    <% end %>
  </div>

  <!-- Cancellation Policy -->
  <% if @booking.event_type.cancellation_policy_hours.present? %>
    <div class="p-4 text-sm text-gray-600 bg-gray-50 rounded-lg">
      <p class="mb-1 font-semibold text-gray-700"><%= t('scheduling.bookings.cancel.cancellation_policy') %></p>
      <p>
        <%= t('scheduling.bookings.cancel.cancellation_policy_message', hours: @booking.event_type.cancellation_policy_hours) %>
      </p>
    </div>
  <% end %>
</div>
