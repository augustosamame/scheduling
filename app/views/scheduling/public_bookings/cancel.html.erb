<% content_for :title, "Cancel Appointment" %>

<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
  <!-- Booking Details -->
  <div class="bg-white rounded-lg shadow-sm p-6 mb-6">
    <h2 class="text-2xl font-bold text-gray-900 mb-4">
      Cancel Appointment
    </h2>

    <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 mb-6">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
          </svg>
        </div>
        <div class="ml-3">
          <p class="text-sm text-yellow-800">
            You are about to cancel the following appointment. This action cannot be undone.
          </p>
        </div>
      </div>
    </div>

    <div class="space-y-3 mb-6">
      <div>
        <p class="text-sm font-medium text-gray-500">Appointment</p>
        <p class="mt-1 text-gray-900"><%= @booking.event_type.title %></p>
      </div>

      <div>
        <p class="text-sm font-medium text-gray-500">With</p>
        <p class="mt-1 text-gray-900"><%= @booking.member.full_name %></p>
      </div>

      <div>
        <p class="text-sm font-medium text-gray-500">Scheduled For</p>
        <p class="mt-1 text-gray-900 font-semibold">
          <%= @booking.start_time.strftime("%A, %B %d, %Y at %I:%M %p") %>
        </p>
      </div>
    </div>

    <%= form_with url: process_cancel_booking_path(@booking.cancellation_token),
                 method: :post,
                 local: true do |f| %>
      <div class="mb-6">
        <label class="block text-sm font-medium text-gray-700 mb-2">
          Reason for cancellation (optional)
        </label>
        <%= text_area_tag :reason,
                         nil,
                         rows: 3,
                         placeholder: "Please let us know why you're cancelling...",
                         class: "w-full rounded-md border-gray-300 shadow-sm focus:border-primary focus:ring-primary" %>
      </div>

      <div class="flex justify-between items-center pt-4 border-t">
        <%= link_to "Keep Appointment",
                   booking_confirmation_path(@booking.uid),
                   class: "text-gray-600 hover:text-gray-900" %>

        <%= f.submit "Cancel Appointment",
                   data: { confirm: "Are you sure you want to cancel this appointment?" },
                   class: "px-6 py-2 bg-red-600 text-white font-semibold rounded-md hover:bg-red-700 transition-colors cursor-pointer" %>
      </div>
    <% end %>
  </div>

  <!-- Cancellation Policy -->
  <% if @booking.event_type.cancellation_policy_hours.present? %>
    <div class="bg-gray-50 rounded-lg p-4 text-sm text-gray-600">
      <p class="font-semibold text-gray-700 mb-1">Cancellation Policy</p>
      <p>
        Appointments can be cancelled up to <%= @booking.event_type.cancellation_policy_hours %> hours before the scheduled time.
      </p>
    </div>
  <% end %>
</div>
