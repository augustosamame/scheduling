<% content_for :title, t('scheduling.bookings.reschedule.title') %>

<!-- Stimulus Controller (same as booking flow) -->
<% content_for :head do %>
  <script src="https://unpkg.com/@hotwired/stimulus/dist/stimulus.umd.js"></script>
  <script>
    (() => {
      const application = Stimulus.Application.start()

      application.register("reschedule", class extends Stimulus.Controller {
        static targets = ["dateStep", "selectedDate", "timeSlots", "timeSlotsColumn", "calendarGrid", "startTimeField", "reasonField"]

        connect() {
          this.selectedDateTime = null
        }

        async selectDate(event) {
          const dateButton = event.currentTarget
          const date = dateButton.dataset.date

          // Update UI - mark selected date with blue circle
          this.element.querySelectorAll('[data-date]').forEach(btn => {
            const span = btn.querySelector('span')
            if (span) {
              span.classList.remove('bg-blue-600', 'text-white')
              span.classList.add('bg-blue-50')
            }
          })

          const selectedSpan = dateButton.querySelector('span')
          if (selectedSpan) {
            selectedSpan.classList.remove('bg-blue-50')
            selectedSpan.classList.add('bg-blue-600', 'text-white')
          }

          // Update selected date display
          if (this.hasSelectedDateTarget) {
            this.selectedDateTarget.textContent = this.formatDate(date)
          }

          // Fetch available time slots
          await this.fetchTimeSlots(date)
        }

        async fetchTimeSlots(date) {
          const url = `/book/<%= @organization.slug %>/<%= @member.booking_slug %>/<%= @event_type.slug %>/availability?date=${date}`
          const response = await fetch(url, { headers: { 'Accept': 'application/json' } })
          const slots = await response.json()
          this.renderTimeSlots(slots, date)
        }

        renderTimeSlots(slots, date) {
          // Switch grid to 2 columns and show time slots column
          if (this.hasCalendarGridTarget) {
            this.calendarGridTarget.classList.remove('grid-cols-1')
            this.calendarGridTarget.classList.add('md:grid-cols-2')
          }
          if (this.hasTimeSlotsColumnTarget) {
            this.timeSlotsColumnTarget.classList.remove('hidden')
          }

          if (slots.length === 0) {
            this.timeSlotsTarget.innerHTML = '<div class="text-gray-500 text-sm p-4 text-center"><%= t('scheduling.bookings.new.no_times_available') %></div>'
            this.timeSlotsTarget.classList.remove('hidden')
            return
          }

          const html = slots.map(slot => {
            const time = new Date(slot.start_time).toLocaleTimeString('<%= I18n.locale %>', {
              hour: '2-digit',
              minute: '2-digit',
              hour12: false
            })

            return `
              <div data-action="click->reschedule#selectTime"
                   data-time="${slot.start_time}"
                   class="time-slot-container cursor-pointer">
                <div class="flex gap-2">
                  <div class="time-display flex-1 px-4 py-3 text-center border border-blue-200 rounded-md hover:border-blue-500 hover:bg-blue-50 transition-colors text-blue-600 font-medium">
                    ${time}
                  </div>
                  <button type="button" class="confirm-button hidden flex-1 px-4 py-3 bg-blue-600 text-white font-semibold rounded-md hover:bg-blue-700 transition-colors" data-action="click->reschedule#confirmTime">
                    <%= t('scheduling.bookings.reschedule.confirm_new_time') %>
                  </button>
                </div>
              </div>
            `
          }).join('')

          this.timeSlotsTarget.innerHTML = html
          this.timeSlotsTarget.classList.remove('hidden')
        }

        selectTime(event) {
          event.stopPropagation()
          const container = event.currentTarget
          const time = container.dataset.time

          // Reset all time slots
          this.element.querySelectorAll('.time-slot-container').forEach(slot => {
            const timeDisplay = slot.querySelector('.time-display')
            const confirmButton = slot.querySelector('.confirm-button')

            timeDisplay.classList.remove('bg-gray-700', 'text-white', 'border-gray-700')
            timeDisplay.classList.add('border-blue-200', 'text-blue-600')

            if (confirmButton) {
              confirmButton.classList.add('hidden')
            }
          })

          // Update selected slot - SPLIT BUTTON LAYOUT
          const timeDisplay = container.querySelector('.time-display')
          const confirmButton = container.querySelector('.confirm-button')

          timeDisplay.classList.remove('border-blue-200', 'text-blue-600', 'hover:border-blue-500', 'hover:bg-blue-50')
          timeDisplay.classList.add('bg-gray-700', 'text-white', 'border-gray-700')

          if (confirmButton) {
            confirmButton.classList.remove('hidden')
          }

          this.selectedDateTime = time
        }

        confirmTime(event) {
          event.preventDefault()
          if (!this.selectedDateTime) {
            alert('<%= t('scheduling.bookings.reschedule.select_time_alert') %>')
            return
          }

          // Set hidden field
          if (this.hasStartTimeFieldTarget) {
            this.startTimeFieldTarget.value = this.selectedDateTime
          }

          // Submit the form
          this.element.querySelector('form').submit()
        }

        formatDate(dateString) {
          const date = new Date(dateString)
          const days = <%= t('scheduling.calendar.days').values.to_json.html_safe %>
          const months = <%= t('scheduling.calendar.months').values.to_json.html_safe %>
          return `${days[date.getDay()]}, ${date.getDate()} de ${months[date.getMonth()]}`
        }
      })
    })()
  </script>
<% end %>

<div class="min-h-screen py-8 px-4 bg-gray-50">
  <div class="mx-auto max-w-6xl">
    <div class="grid md:grid-cols-[400px_1fr] gap-8">
      <!-- Left Sidebar: Booking Info -->
      <div class="space-y-6">
        <!-- Current Booking Info -->
        <div class="p-6 bg-white rounded-lg shadow-sm">
          <h1 class="mb-4 text-2xl font-bold text-gray-900">
            <%= t('scheduling.bookings.reschedule.title') %>
          </h1>

          <div class="p-4 mb-6 bg-blue-50 rounded-lg border border-blue-200">
            <div class="flex">
              <div class="flex-shrink-0">
                <svg class="w-5 h-5 text-blue-400" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
                </svg>
              </div>
              <div class="ml-3">
                <p class="text-sm text-blue-800">
                  <%= t('scheduling.bookings.reschedule.select_new_time') %>
                </p>
              </div>
            </div>
          </div>

          <!-- Current Appointment Details -->
          <div class="p-4 mb-4 bg-gray-50 rounded-lg border border-gray-200">
            <h3 class="mb-3 text-sm font-semibold text-gray-700">
              <%= t('scheduling.bookings.reschedule.current_appointment') %>
            </h3>
            <div class="space-y-2">
              <div>
                <p class="text-xs text-gray-500"><%= t('scheduling.bookings.reschedule.appointment_type') %></p>
                <p class="font-medium text-gray-900"><%= @booking.event_type.title %></p>
              </div>
              <div>
                <p class="text-xs text-gray-500"><%= t('scheduling.bookings.reschedule.with') %></p>
                <p class="text-gray-900"><%= @booking.member.full_name %></p>
              </div>
              <div>
                <p class="text-xs text-gray-500"><%= t('scheduling.bookings.reschedule.currently_scheduled') %></p>
                <p class="font-semibold text-gray-900">
                  <%= l(@booking.start_time.in_time_zone(@booking.timezone), format: :long) %>
                </p>
                <p class="text-lg font-bold text-gray-900">
                  <%= l(@booking.start_time.in_time_zone(@booking.timezone), format: :time) %>
                </p>
              </div>
            </div>
          </div>

          <!-- Duration -->
          <div class="flex items-center gap-2 pb-4 mb-4 text-gray-600 border-b">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span><%= t('scheduling.event_types.duration_minutes', minutes: @event_type.duration_minutes) %></span>
          </div>

          <!-- Pricing -->
          <% if @event_type.price_cents && @event_type.price_cents > 0 %>
            <div class="pt-4 border-t">
              <p class="mb-2 text-xs text-gray-500"><%= t('scheduling.bookings.reschedule.price') %></p>
              <p class="text-2xl font-bold text-blue-600">
                <%= format_price(@event_type.price_cents, @event_type.price_currency) %>
              </p>
            </div>
          <% else %>
            <div class="pt-4 border-t">
              <span class="inline-block px-3 py-1 text-sm font-bold text-green-700 bg-green-100 rounded-full">
                <%= t('scheduling.event_types.free') %>
              </span>
            </div>
          <% end %>
        </div>

        <!-- Rescheduling Policy -->
        <% if @booking.event_type.rescheduling_policy_hours.present? %>
          <div class="p-4 text-sm text-gray-600 bg-white rounded-lg shadow-sm">
            <p class="mb-1 font-semibold text-gray-700">
              <%= t('scheduling.bookings.reschedule.rescheduling_policy') %>
            </p>
            <p>
              <%= t('scheduling.bookings.reschedule.rescheduling_policy_message', hours: @booking.event_type.rescheduling_policy_hours) %>
            </p>
          </div>
        <% end %>
      </div>

      <!-- Right Panel: Calendar & Time Slots -->
      <div class="p-6 bg-white rounded-lg shadow-sm" data-controller="reschedule">
        <%= form_with url: process_reschedule_booking_path(@booking.reschedule_token),
                     method: :post,
                     local: true do |f| %>
          <%= hidden_field_tag :new_start_time, nil, data: { reschedule_target: "startTimeField" } %>
          <%= hidden_field_tag :reason, nil, data: { reschedule_target: "reasonField" } %>

          <div data-reschedule-target="dateStep">
            <h2 class="mb-6 text-xl font-semibold text-gray-900">
              <%= t('scheduling.bookings.reschedule.select_new_time') %>
            </h2>

            <!-- Calendar and Time Slots Grid -->
            <div data-reschedule-target="calendarGrid" class="grid grid-cols-1 gap-6">
              <!-- Left: Calendar -->
              <div class="w-full" style="max-width: 310px;">
                <%= render partial: 'calendar', locals: {
                  available_dates: @available_dates,
                  controller_name: 'reschedule'
                } %>
              </div>

              <!-- Right: Time Slots - HIDDEN INITIALLY -->
              <div class="flex-1 hidden" data-reschedule-target="timeSlotsColumn">
                <div class="mb-3">
                  <p class="text-sm font-semibold text-gray-900" data-reschedule-target="selectedDate"></p>
                </div>

                <div data-reschedule-target="timeSlots" class="hidden space-y-2 max-h-96 overflow-y-auto pr-2">
                  <!-- Time slots loaded via Stimulus -->
                </div>
              </div>
            </div>

            <!-- Timezone Info -->
            <div class="mt-6 pt-6 border-t">
              <p class="text-sm text-gray-600">
                <svg class="inline w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <%= t('scheduling.bookings.reschedule.timezone') %>: <strong><%= @booking.timezone %></strong>
              </p>
            </div>

            <!-- Cancel Link -->
            <div class="mt-6 pt-6 border-t text-center">
              <%= link_to t('scheduling.bookings.reschedule.cancel'),
                         booking_confirmation_path(@booking.uid, locale: I18n.locale),
                         class: "text-gray-600 hover:text-gray-900 underline" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
