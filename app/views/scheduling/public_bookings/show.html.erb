<% content_for :title, t('scheduling.bookings.show.title') %>

<div class="px-4 mx-auto max-w-3xl sm:px-6 lg:px-8">
  <!-- Success Message -->
  <div class="p-6 mb-6 bg-green-50 rounded-lg border border-green-200">
    <div class="flex">
      <div class="flex-shrink-0">
        <svg class="w-8 h-8 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
      </div>
      <div class="ml-3">
        <h2 class="text-2xl font-bold text-green-900">
          <%= t('scheduling.bookings.show.confirmed_title') %>
        </h2>
        <p class="mt-2 text-green-700">
          <%= t('scheduling.bookings.show.confirmed_message', email: @booking.client.email) %>
        </p>
      </div>
    </div>
  </div>

  <!-- Booking Details Card -->
  <div class="p-6 mb-6 bg-white rounded-lg shadow-sm">
    <h3 class="pb-2 mb-4 text-lg font-semibold text-gray-900 border-b">
      <%= t('scheduling.bookings.show.appointment_details') %>
    </h3>

    <div class="space-y-4">
      <!-- Event Type -->
      <div class="flex items-start">
        <div class="flex-shrink-0">
          <svg class="mt-0.5 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
          </svg>
        </div>
        <div class="ml-3">
          <p class="text-sm font-medium text-gray-500"><%= t('scheduling.bookings.show.appointment_type') %></p>
          <p class="mt-1 text-gray-900"><%= @booking.event_type.title %></p>
        </div>
      </div>

      <!-- Date & Time -->
      <div class="flex items-start">
        <div class="flex-shrink-0">
          <svg class="mt-0.5 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
          </svg>
        </div>
        <div class="ml-3">
          <p class="text-sm font-medium text-gray-500"><%= t('scheduling.bookings.show.date_time') %></p>
          <p class="mt-1 font-semibold text-gray-900">
            <%= @booking.start_time.strftime("%A, %B %d, %Y") %>
          </p>
          <p class="text-gray-900">
            <%= @booking.start_time.strftime("%I:%M %p") %> - <%= @booking.end_time.strftime("%I:%M %p") %>
            <span class="text-sm text-gray-500">(<%= @booking.timezone %>)</span>
          </p>
        </div>
      </div>

      <!-- Duration -->
      <div class="flex items-start">
        <div class="flex-shrink-0">
          <svg class="mt-0.5 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <div class="ml-3">
          <p class="text-sm font-medium text-gray-500"><%= t('scheduling.bookings.show.duration') %></p>
          <p class="mt-1 text-gray-900"><%= @booking.event_type.duration_minutes %> <%= t('scheduling.bookings.show.minutes') %></p>
        </div>
      </div>

      <!-- Member -->
      <div class="flex items-start">
        <div class="flex-shrink-0">
          <svg class="mt-0.5 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
          </svg>
        </div>
        <div class="ml-3">
          <p class="text-sm font-medium text-gray-500"><%= t('scheduling.bookings.show.with') %></p>
          <p class="mt-1 text-gray-900"><%= @booking.member.full_name %></p>
          <% if @booking.member.title.present? %>
            <p class="text-sm text-gray-600"><%= @booking.member.title %></p>
          <% end %>
        </div>
      </div>

      <!-- Location Type -->
      <% if @booking.event_type.location_type.present? %>
        <div class="flex items-start">
          <div class="flex-shrink-0">
            <svg class="mt-0.5 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
          </div>
          <div class="ml-3">
            <p class="text-sm font-medium text-gray-500"><%= t('scheduling.bookings.show.location') %></p>
            <p class="mt-1 text-gray-900"><%= @booking.event_type.location_type.titleize %></p>
          </div>
        </div>
      <% end %>

      <!-- Booking Reference -->
      <div class="flex items-start">
        <div class="flex-shrink-0">
          <svg class="mt-0.5 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14"></path>
          </svg>
        </div>
        <div class="ml-3">
          <p class="text-sm font-medium text-gray-500"><%= t('scheduling.bookings.show.confirmation_code') %></p>
          <p class="mt-1 font-mono text-sm text-gray-900"><%= @booking.uid %></p>
        </div>
      </div>
    </div>
  </div>

  <!-- Your Information -->
  <div class="p-6 mb-6 bg-white rounded-lg shadow-sm">
    <h3 class="pb-2 mb-4 text-lg font-semibold text-gray-900 border-b">
      <%= t('scheduling.bookings.show.your_information') %>
    </h3>

    <div class="space-y-2">
      <p class="text-gray-900"><strong><%= @booking.client.full_name %></strong></p>
      <p class="text-gray-600"><%= @booking.client.email %></p>
      <% if @booking.client.phone.present? %>
        <p class="text-gray-600"><%= @booking.client.phone %></p>
      <% end %>
    </div>
  </div>

  <!-- Answers to Custom Questions -->
  <% if @booking.booking_answers.any? %>
    <div class="p-6 mb-6 bg-white rounded-lg shadow-sm">
      <h3 class="pb-2 mb-4 text-lg font-semibold text-gray-900 border-b">
        <%= t('scheduling.bookings.show.additional_information') %>
      </h3>

      <div class="space-y-3">
        <% @booking.booking_answers.each do |answer| %>
          <div>
            <p class="text-sm font-medium text-gray-500"><%= answer.booking_question.label %></p>
            <p class="mt-1 text-gray-900"><%= answer.answer %></p>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Notes -->
  <% if @booking.notes.present? %>
    <div class="p-6 mb-6 bg-white rounded-lg shadow-sm">
      <h3 class="pb-2 mb-4 text-lg font-semibold text-gray-900 border-b">
        <%= t('scheduling.bookings.show.additional_notes') %>
      </h3>
      <p class="text-gray-700"><%= @booking.notes %></p>
    </div>
  <% end %>

  <!-- Actions -->
  <% if @booking.can_cancel? || @booking.can_reschedule? %>
    <div class="p-6 mb-6 bg-gray-50 rounded-lg">
      <h3 class="mb-4 text-lg font-semibold text-gray-900">
        <%= t('scheduling.bookings.show.manage_appointment') %>
      </h3>

      <div class="flex flex-wrap gap-3">
        <% if @booking.can_reschedule? %>
          <%= link_to t('scheduling.bookings.show.reschedule_appointment'),
                     reschedule_booking_path(@booking.reschedule_token),
                     class: "inline-flex items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50" %>
        <% end %>

        <% if @booking.can_cancel? %>
          <%= link_to t('scheduling.bookings.show.cancel_appointment'),
                     cancel_booking_path(@booking.cancellation_token),
                     class: "inline-flex items-center px-4 py-2 border border-red-300 shadow-sm text-sm font-medium rounded-md text-red-700 bg-white hover:bg-red-50" %>
        <% end %>
      </div>

      <p class="mt-4 text-sm text-gray-600">
        <% if @booking.event_type.allow_cancellation %>
          <%= t('scheduling.bookings.show.cancel_policy', hours: @booking.event_type.cancellation_policy_hours) %>
        <% end %>
        <% if @booking.event_type.allow_rescheduling %>
          <%= t('scheduling.bookings.show.reschedule_policy', hours: @booking.event_type.rescheduling_policy_hours) %>
        <% end %>
      </p>
    </div>
  <% end %>

  <!-- Add to Calendar -->
  <div class="p-6 text-center bg-white rounded-lg shadow-sm">
    <h3 class="mb-3 text-lg font-semibold text-gray-900">
      <%= t('scheduling.bookings.show.add_to_calendar') %>
    </h3>
    <p class="mb-4 text-gray-600">
      <%= t('scheduling.bookings.show.add_to_calendar_message') %>
    </p>

    <%= link_to download_booking_calendar_path(@booking.uid, locale: I18n.locale),
          class: "inline-flex items-center px-6 py-3 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 transition-colors shadow-sm" do %>
      <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
      </svg>
      <%= t('scheduling.bookings.show.add_to_calendar') %>
    <% end %>

    <p class="mt-3 text-xs text-gray-500">
      Works with Google Calendar, Outlook, Apple Calendar, and more
    </p>
  </div>
</div>
