<% content_for :title, t('scheduling.bookings.show.title') %>

<% content_for :head do %>
  <!-- Stimulus.js for interactive payment button -->
  <script src="https://unpkg.com/@hotwired/stimulus/dist/stimulus.umd.js"></script>
  <!-- Culqi.js v4 for optional payment processing -->
  <script src="https://checkout.culqi.com/js/v4"></script>
  <script>
    (() => {
      const application = Stimulus.Application.start()

      // Import the Culqi payment controller
      // We need to inline it since we don't have a build system
      const CulqiPaymentController = class extends Stimulus.Controller {
        static targets = ["payButton", "message"]
        static values = {
          amount: Number,
          currency: String,
          description: String,
          publicKey: String,
          bookingUid: String
        }

        connect() {
          console.log("Culqi payment controller connected")
        }

        payExisting(event) {
          event.preventDefault()

          console.log('Paying for existing booking:', {
            bookingUid: this.bookingUidValue,
            amount: this.amountValue
          })

          this.buttonElement = event.currentTarget
          const originalContent = this.buttonElement.innerHTML
          this.buttonElement.dataset.originalContent = originalContent

          this.buttonElement.disabled = true
          this.buttonElement.classList.add('opacity-75')
          this.buttonElement.innerHTML = '<svg class="inline mr-3 -ml-1 w-5 h-5 text-white animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>Procesando...'

          try {
            Culqi.publicKey = this.publicKeyValue
            Culqi.settings({
              title: 'Pago de Cita',
              currency: this.currencyValue,
              description: this.descriptionValue,
              amount: this.amountValue
            })
            Culqi.options({
              style: {
                maincolor: '#0ea5e9',
                auxcolor: '#475569',
                maintext: '#1e293b',
                auxtext: '#64748b'
              },
              modal: true,
              installments: false,
              paymentMethods: {
                tarjeta: true,
                yape: false,
                billetera: false,
                bancaMovil: false,
                agente: false,
                cuotealo: false
              }
            })
            Culqi.open()
          } catch (error) {
            console.error('Error initializing Culqi:', error)
            this.showError('Error al inicializar el sistema de pagos')
            this.resetButton()
          }

          this.setupCulqiHandlers()
        }

        setupCulqiHandlers() {
          window.culqi = () => {
            if (Culqi.token) {
              console.log('Culqi token received:', Culqi.token)
              this.processExistingBookingPayment(Culqi.token.id)
            } else {
              console.error('No token received')
              this.showError('No se recibió el token de pago')
              this.resetButton()
            }
          }

          window.culqi_close = () => {
            console.log('Culqi modal closed')
            this.resetButton()
          }

          window.culqi_error = (error) => {
            console.error('Culqi error:', error)
            this.showError(error.user_message || 'Error en el procesamiento del pago')
            this.resetButton()
          }
        }

        async processExistingBookingPayment(token) {
          try {
            const bookingUid = this.bookingUidValue || this.extractBookingUidFromUrl()

            const response = await fetch(`/book/bookings/${bookingUid}/process_payment`, {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': document.querySelector('[name="csrf-token"]').content,
                'Accept': 'application/json'
              },
              body: JSON.stringify({
                payment_provider: 'culqi',
                token_id: token
              })
            })

            const data = await response.json()

            if (data.success) {
              this.showSuccess(data.message || 'Pago procesado exitosamente')
              setTimeout(() => window.location.reload(), 2000)
            } else if (data.requires_3ds) {
              alert('Verificación 3D Secure requerida. Complete la verificación en la nueva ventana.')
              window.open(data.three_d_secure_url, '_blank')
              this.resetButton()
            } else {
              this.showError(data.error || 'Error procesando el pago')
              this.resetButton()
            }
          } catch (error) {
            console.error('Network error:', error)
            this.showError('Error de conexión. Intente nuevamente.')
            this.resetButton()
          }
        }

        extractBookingUidFromUrl() {
          const match = window.location.pathname.match(/bookings\/([^\/]+)/)
          return match ? match[1] : null
        }

        resetButton() {
          if (this.buttonElement) {
            this.buttonElement.disabled = false
            this.buttonElement.classList.remove('opacity-75')
            const originalContent = this.buttonElement.dataset.originalContent
            if (originalContent) {
              this.buttonElement.innerHTML = originalContent
              delete this.buttonElement.dataset.originalContent
            }
          }
        }

        showSuccess(message) {
          if (this.hasMessageTarget) {
            this.messageTarget.className = 'mb-3 p-4 border rounded-lg bg-green-50 border-green-200 text-green-800'
            this.messageTarget.innerHTML = `<div class="flex items-center"><svg class="mr-3 w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg><span>${message}</span></div>`
            this.messageTarget.classList.remove('hidden')
          }
        }

        showError(message) {
          if (this.hasMessageTarget) {
            this.messageTarget.className = 'mb-3 p-4 border rounded-lg bg-red-50 border-red-200 text-red-800'
            this.messageTarget.innerHTML = `<div class="flex items-center"><svg class="mr-3 w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path></svg><span>${message}</span></div>`
            this.messageTarget.classList.remove('hidden')
          }
        }
      }

      application.register("scheduling--culqi-payment", CulqiPaymentController)
    })()
  </script>
<% end %>

<div class="px-4 mx-auto max-w-4xl sm:px-6 lg:px-8">
  <!-- Success Message -->
  <div class="overflow-hidden mb-8 bg-gradient-to-r from-green-500 to-emerald-600 rounded-xl shadow-2xl">
    <div class="p-8">
      <div class="flex items-center">
        <div class="flex-shrink-0">
          <div class="p-4 bg-white bg-opacity-30 rounded-full">
            <svg class="w-12 h-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
        </div>
        <div class="ml-6">
          <h2 class="text-3xl font-bold text-white">
            <%= t('scheduling.bookings.show.confirmed_title') %>
          </h2>
          <p class="mt-2 text-lg text-green-50">
            <%= t('scheduling.bookings.show.confirmed_message', email: @booking.client.email) %>
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Booking Details Card -->
  <div class="p-8 mb-8 bg-white rounded-xl border-t-4 border-blue-500 shadow-lg">
    <div class="flex items-center mb-6">
      <div class="p-3 bg-blue-100 rounded-lg">
        <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
        </svg>
      </div>
      <h3 class="ml-4 text-2xl font-bold text-gray-900">
        <%= t('scheduling.bookings.show.appointment_details') %>
      </h3>
    </div>

    <div class="space-y-4">
      <!-- Event Type -->
      <div class="flex items-start">
        <div class="flex-shrink-0">
          <svg class="mt-0.5 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
          </svg>
        </div>
        <div class="ml-3">
          <p class="text-sm font-medium text-gray-500"><%= t('scheduling.bookings.show.appointment_type') %></p>
          <p class="mt-1 text-gray-900"><%= @booking.event_type.title %></p>
        </div>
      </div>

      <!-- Date & Time -->
      <div class="flex items-start">
        <div class="flex-shrink-0">
          <svg class="mt-0.5 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
          </svg>
        </div>
        <div class="ml-3">
          <p class="text-sm font-medium text-gray-500"><%= t('scheduling.bookings.show.date_time') %></p>
          <p class="mt-1 font-semibold text-gray-900">
            <%= l(@booking.start_time.in_time_zone(@booking.timezone), format: :long) %>
          </p>
          <p class="text-gray-900">
            <%= l(@booking.start_time.in_time_zone(@booking.timezone), format: :time) %> - <%= l(@booking.end_time.in_time_zone(@booking.timezone), format: :time) %>
            <span class="text-sm text-gray-500">(<%= @booking.timezone %>)</span>
          </p>
        </div>
      </div>

      <!-- Duration -->
      <div class="flex items-start">
        <div class="flex-shrink-0">
          <svg class="mt-0.5 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <div class="ml-3">
          <p class="text-sm font-medium text-gray-500"><%= t('scheduling.bookings.show.duration') %></p>
          <p class="mt-1 text-gray-900"><%= @booking.event_type.duration_minutes %> <%= t('scheduling.bookings.show.minutes') %></p>
        </div>
      </div>

      <!-- Member -->
      <div class="flex items-start">
        <div class="flex-shrink-0">
          <svg class="mt-0.5 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
          </svg>
        </div>
        <div class="ml-3">
          <p class="text-sm font-medium text-gray-500"><%= t('scheduling.bookings.show.with') %></p>
          <p class="mt-1 text-gray-900"><%= @booking.member.full_name %></p>
          <% if @booking.member.title.present? %>
            <p class="text-sm text-gray-600"><%= @booking.member.title %></p>
          <% end %>
        </div>
      </div>

      <!-- Location -->
      <% if @booking.event_type.location_type.present? %>
        <div class="flex items-start">
          <div class="flex-shrink-0">
            <svg class="mt-0.5 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <% if @booking.event_type.location_type == 'in_person' %>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              <% elsif @booking.event_type.location_type == 'video' %>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
              <% else %>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
              <% end %>
            </svg>
          </div>
          <div class="ml-3">
            <p class="text-sm font-medium text-gray-500"><%= t('scheduling.bookings.show.location') %></p>
            <% if @booking.event_type.location_type == 'in_person' %>
              <% if @booking.event_type.full_address.present? %>
                <p class="mt-1 text-gray-900"><%= @booking.event_type.full_address %></p>
                <% if @booking.event_type.location_instructions.present? %>
                  <p class="mt-1 text-sm text-gray-600"><%= @booking.event_type.location_instructions %></p>
                <% end %>
                <% if @booking.event_type.google_maps_url.present? %>
                  <%= link_to @booking.event_type.google_maps_url, target: "_blank", class: "inline-flex items-center mt-2 text-sm text-blue-600 hover:text-blue-800" do %>
                    <svg class="mr-1 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                    </svg>
                    <%= t('scheduling.bookings.show.view_map') %>
                  <% end %>
                <% end %>
              <% else %>
                <p class="mt-1 text-gray-900"><%= t('scheduling.event_types.in_person') %></p>
              <% end %>
            <% elsif @booking.event_type.location_type == 'video' %>
              <p class="mt-1 text-gray-900"><%= t('scheduling.event_types.video_call') %></p>
              <% if @booking.video_call_url.present? %>
                <p class="mt-1 text-sm text-gray-600"><%= @booking.video_call_url %></p>
              <% end %>
            <% elsif @booking.event_type.location_type == 'phone' %>
              <p class="mt-1 text-gray-900"><%= t('scheduling.event_types.phone') %></p>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Payment Information -->
  <% if @booking.event_type.requires_payment %>
    <div class="p-8 mb-8 bg-white rounded-xl shadow-lg border-t-4 <%= @booking.payment_status == 'paid' ? 'border-green-500' : 'border-yellow-500' %>">
      <div class="flex items-center mb-6">
        <div class="p-3 <%= @booking.payment_status == 'paid' ? 'bg-green-100' : 'bg-yellow-100' %> rounded-lg">
          <svg class="w-6 h-6 <%= @booking.payment_status == 'paid' ? 'text-green-600' : 'text-yellow-600' %>" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <h3 class="ml-4 text-2xl font-bold text-gray-900">
          <%= t('scheduling.bookings.show.payment_information') %>
        </h3>
      </div>

      <!-- Price -->
      <div class="flex justify-between items-center p-6 mb-6 bg-gradient-to-r from-blue-50 to-indigo-50 rounded-xl">
        <span class="text-lg font-medium text-gray-700"><%= t('scheduling.bookings.show.appointment_cost') %></span>
        <span class="text-4xl font-bold text-blue-600">
          <%= format_price(@booking.event_type.price_cents, @booking.event_type.price_currency) %>
        </span>
      </div>

      <!-- Payment Status -->
      <% if @booking.payment_status == 'paid' %>
        <!-- Payment Confirmed -->
        <div class="overflow-hidden bg-gradient-to-r from-green-500 to-emerald-600 rounded-xl shadow-lg">
          <div class="p-6">
            <div class="flex items-center">
              <svg class="mr-3 w-8 h-8 text-white" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-xl font-bold text-white"><%= t('scheduling.bookings.show.payment_confirmed') %></span>
            </div>
            <p class="mt-3 text-green-50">
              <%= t('scheduling.bookings.show.payment_confirmed_message') %>
            </p>
          </div>
        </div>

      <% elsif @booking.payment_status == 'pending' %>
        <!-- Payment Pending (Optional Payment) -->
        <div class="overflow-hidden bg-gradient-to-r from-yellow-400 to-orange-500 rounded-xl shadow-lg">
          <div class="p-6">
            <div class="flex items-center mb-3">
              <svg class="mr-3 w-8 h-8 text-white" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
              </svg>
              <span class="text-xl font-bold text-white"><%= t('scheduling.bookings.show.payment_pending') %></span>
            </div>
            <p class="mb-6 text-yellow-50">
              <%= t('scheduling.bookings.show.payment_pending_message') %>
            </p>

            <!-- Pay Now Button (Culqi) -->
            <div data-controller="scheduling--culqi-payment"
                 data-scheduling--culqi-payment-amount-value="<%= @booking.event_type.price_cents %>"
                 data-scheduling--culqi-payment-currency-value="<%= @booking.event_type.price_currency %>"
                 data-scheduling--culqi-payment-description-value="<%= @booking.event_type.title %> - <%= @booking.member.full_name %>"
                 data-scheduling--culqi-payment-public-key-value="<%= Culqi.public_key %>"
                 data-scheduling--culqi-payment-booking-uid-value="<%= @booking.uid %>">

              <div data-scheduling--culqi-payment-target="message" class="hidden mb-3"></div>

              <button type="button"
                      data-scheduling--culqi-payment-target="payButton"
                      data-action="click->scheduling--culqi-payment#payExisting"
                      class="flex justify-center items-center px-8 py-4 w-full text-lg font-bold text-yellow-600 bg-white rounded-xl shadow-lg transition-all hover:bg-yellow-50 hover:shadow-xl">
                <svg class="mr-3 w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path>
                </svg>
                <%= t('scheduling.payments.pay_now') %> <%= format_price(@booking.event_type.price_cents, @booking.event_type.price_currency) %>
              </button>
            </div>
          </div>
        </div>

      <% else %>
        <!-- No Payment Required -->
        <div class="p-4 bg-blue-50 rounded-lg border border-blue-200">
          <p class="text-sm text-blue-700">
            <%= t('scheduling.bookings.show.no_payment_required') %>
          </p>
        </div>
      <% end %>
    </div>
  <% end %>

  <!-- Actions -->
  <% if @booking.can_cancel? || @booking.can_reschedule? %>
    <div class="p-8 mb-8 bg-white rounded-xl border-t-4 border-gray-500 shadow-lg">
      <div class="flex items-center mb-6">
        <div class="p-3 bg-gray-100 rounded-lg">
          <svg class="w-6 h-6 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"></path>
          </svg>
        </div>
        <h3 class="ml-4 text-2xl font-bold text-gray-900">
          <%= t('scheduling.bookings.show.manage_appointment') %>
        </h3>
      </div>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <% if @booking.can_reschedule? %>
          <%= link_to reschedule_booking_path(@booking.reschedule_token),
                     class: "flex items-center justify-center px-6 py-4 bg-gradient-to-r from-blue-50 to-indigo-50 border-2 border-blue-200 rounded-xl text-blue-700 font-semibold hover:from-blue-100 hover:to-indigo-100 transition-all shadow-sm hover:shadow-md" do %>
            <svg class="mr-3 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
            <%= t('scheduling.bookings.show.reschedule_appointment') %>
          <% end %>
        <% end %>

        <% if @booking.can_cancel? %>
          <%= link_to cancel_booking_path(@booking.cancellation_token),
                     class: "flex items-center justify-center px-6 py-4 bg-gradient-to-r from-red-50 to-pink-50 border-2 border-red-200 rounded-xl text-red-700 font-semibold hover:from-red-100 hover:to-pink-100 transition-all shadow-sm hover:shadow-md" do %>
            <svg class="mr-3 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
            <%= t('scheduling.bookings.show.cancel_appointment') %>
          <% end %>
        <% end %>
      </div>

      <div class="p-4 mt-6 bg-gray-50 rounded-lg">
        <p class="text-sm text-gray-600">
          <svg class="inline mr-1 w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <% if @booking.event_type.allow_cancellation %>
            <%= t('scheduling.bookings.show.cancel_policy', hours: @booking.event_type.cancellation_policy_hours) %>
          <% end %>
          <% if @booking.event_type.allow_rescheduling %>
            <%= t('scheduling.bookings.show.reschedule_policy', hours: @booking.event_type.rescheduling_policy_hours) %>
          <% end %>
        </p>
      </div>
    </div>
  <% end %>

  <!-- Add to Calendar -->
  <div class="p-8 mb-8 text-center bg-white rounded-xl border-t-4 border-blue-500 shadow-lg">
    <div class="flex justify-center items-center mb-6">
      <div class="p-3 bg-blue-100 rounded-lg">
        <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
        </svg>
      </div>
      <h3 class="ml-4 text-2xl font-bold text-gray-900">
        <%= t('scheduling.bookings.show.add_to_calendar') %>
      </h3>
    </div>

    <p class="mx-auto mb-6 max-w-md text-gray-600">
      <%= t('scheduling.bookings.show.add_to_calendar_message') %>
    </p>

    <%= link_to download_booking_calendar_path(@booking.uid, locale: I18n.locale),
          class: "inline-flex items-center px-8 py-4 bg-gradient-to-r from-blue-600 to-indigo-600 text-white font-bold rounded-xl hover:from-blue-700 hover:to-indigo-700 transition-all shadow-lg hover:shadow-xl transform hover:-translate-y-0.5" do %>
      <svg class="mr-3 w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
      </svg>
      <%= t('scheduling.bookings.show.add_to_calendar') %>
    <% end %>

    <p class="mt-4 text-sm text-gray-500">
      <svg class="inline mr-1 w-4 h-4 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
      </svg>
      Works with Google Calendar, Outlook, Apple Calendar, and more
    </p>
  </div>

  <!-- Your Information -->
  <div class="p-8 mb-8 bg-white rounded-xl border-t-4 border-purple-500 shadow-lg">
    <div class="flex items-center mb-6">
      <div class="p-3 bg-purple-100 rounded-lg">
        <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
        </svg>
      </div>
      <h3 class="ml-4 text-2xl font-bold text-gray-900">
        <%= t('scheduling.bookings.show.your_information') %>
      </h3>
    </div>

    <div class="space-y-4">
      <div class="flex items-start">
        <div class="flex-shrink-0">
          <svg class="mt-0.5 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
          </svg>
        </div>
        <div class="ml-3">
          <p class="text-sm font-medium text-gray-500"><%= t('scheduling.bookings.show.name') || 'Nombre' %></p>
          <p class="mt-1 text-lg font-semibold text-gray-900"><%= @booking.client.full_name %></p>
        </div>
      </div>

      <div class="flex items-start">
        <div class="flex-shrink-0">
          <svg class="mt-0.5 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
        </div>
        <div class="ml-3">
          <p class="text-sm font-medium text-gray-500"><%= t('scheduling.bookings.show.email') || 'Correo Electrónico' %></p>
          <p class="mt-1 text-gray-900"><%= @booking.client.email %></p>
        </div>
      </div>

      <% if @booking.client.phone.present? %>
        <div class="flex items-start">
          <div class="flex-shrink-0">
            <svg class="mt-0.5 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
          </div>
          <div class="ml-3">
            <p class="text-sm font-medium text-gray-500"><%= t('scheduling.bookings.show.phone') || 'Teléfono' %></p>
            <p class="mt-1 text-gray-900"><%= @booking.client.phone %></p>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Answers to Custom Questions -->
  <% if @booking.booking_answers.any? %>
    <div class="p-8 mb-8 bg-white rounded-xl border-t-4 border-indigo-500 shadow-lg">
      <div class="flex items-center mb-6">
        <div class="p-3 bg-indigo-100 rounded-lg">
          <svg class="w-6 h-6 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
        </div>
        <h3 class="ml-4 text-2xl font-bold text-gray-900">
          <%= t('scheduling.bookings.show.additional_information') %>
        </h3>
      </div>

      <div class="space-y-4">
        <% @booking.booking_answers.each do |answer| %>
          <div class="flex items-start">
            <div class="flex-shrink-0">
              <svg class="mt-0.5 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
              </svg>
            </div>
            <div class="flex-1 ml-3">
              <p class="text-sm font-medium text-gray-500"><%= answer.booking_question.label %></p>
              <p class="mt-1 text-gray-900"><%= answer.answer %></p>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Notes -->
  <% if @booking.notes.present? %>
    <div class="p-6 mb-6 bg-white rounded-lg shadow-sm">
      <h3 class="pb-2 mb-4 text-lg font-semibold text-gray-900 border-b">
        <%= t('scheduling.bookings.show.additional_notes') %>
      </h3>
      <p class="text-gray-700"><%= @booking.notes %></p>
    </div>
  <% end %>
</div>
