<% content_for :title, "Book #{@event_type.title}" %>

<% content_for :head do %>
  <script src="https://unpkg.com/@hotwired/stimulus/dist/stimulus.umd.js"></script>
  <!-- Culqi.js v4 for payment processing -->
  <script src="https://checkout.culqi.com/js/v4"></script>
  <script>
    (() => {
      const application = Stimulus.Application.start()

      application.register("booking", class extends Stimulus.Controller {
        static targets = ["dateStep", "detailsStep", "selectedDate", "timeSlots", "timeSlotsColumn", "calendarGrid", "selectedTime", "startTimeField"]

        connect() {
          this.selectedDateTime = null
        }

        async selectDate(event) {
          const dateButton = event.currentTarget
          const date = dateButton.dataset.date

          // Update UI - mark selected date
          this.element.querySelectorAll('[data-date]').forEach(btn => {
            const span = btn.querySelector('span')
            if (span) {
              span.classList.remove('bg-blue-600', 'text-white')
              span.classList.add('bg-blue-50')
            }
          })

          const selectedSpan = dateButton.querySelector('span')
          if (selectedSpan) {
            selectedSpan.classList.remove('bg-blue-50')
            selectedSpan.classList.add('bg-blue-600', 'text-white')
          }

          // Update selected date display
          if (this.hasSelectedDateTarget) {
            this.selectedDateTarget.textContent = this.formatDate(date)
          }

          // Hide next button when changing date
          if (this.hasNextButtonTarget) {
            this.nextButtonTarget.classList.add('hidden')
          }

          // Fetch available time slots
          await this.fetchTimeSlots(date)
        }

        async fetchTimeSlots(date) {
          try {
            // Build URL for availability check
            const url = `/book/<%= @organization.slug %>/<%= @member.booking_slug %>/<%= @event_type.slug %>/availability?date=${date}`

            const response = await fetch(url, {
              headers: { 'Accept': 'application/json' }
            })

            if (!response.ok) throw new Error('Failed to fetch')

            const slots = await response.json()
            this.renderTimeSlots(slots, date)
          } catch (error) {
            console.error('Error:', error)
            if (this.hasTimeSlotsTarget) {
              this.timeSlotsTarget.innerHTML = '<div class="p-4 text-sm text-red-600">Error al cargar horarios</div>'
            }
          }
        }

        renderTimeSlots(slots, date) {
          if (!this.hasTimeSlotsTarget) return

          // Switch grid to 2 columns and show time slots column
          if (this.hasCalendarGridTarget) {
            this.calendarGridTarget.classList.remove('grid-cols-1')
            this.calendarGridTarget.classList.add('md:grid-cols-2')
          }
          if (this.hasTimeSlotsColumnTarget) {
            this.timeSlotsColumnTarget.classList.remove('hidden')
          }

          if (slots.length === 0) {
            this.timeSlotsTarget.innerHTML = '<div class="p-4 text-sm text-center text-gray-500"><%= t('scheduling.bookings.new.no_times_available') %></div>'
            this.timeSlotsTarget.classList.remove('hidden')
            return
          }

          const html = slots.map(slot => {
            return `
              <div data-action="click->booking#selectTime"
                   data-time="${slot.start_time}"
                   class="cursor-pointer time-slot-container">
                <div class="flex gap-2">
                  <div class="flex-1 px-4 py-3 font-medium text-center text-blue-600 rounded-md border border-blue-200 transition-colors time-display hover:border-blue-500 hover:bg-blue-50">
                    ${slot.display_time}
                  </div>
                  <button type="button" class="hidden flex-1 px-4 py-3 font-semibold text-white bg-blue-600 rounded-md transition-colors next-button hover:bg-blue-700" data-action="click->booking#showDetails">
                    <%= t('scheduling.bookings.new.next') %>
                  </button>
                </div>
              </div>
            `
          }).join('')

          this.timeSlotsTarget.innerHTML = html
          this.timeSlotsTarget.classList.remove('hidden')
        }

        selectTime(event) {
          event.stopPropagation()
          const container = event.currentTarget
          const time = container.dataset.time

          // Reset all time slots to unselected state
          this.element.querySelectorAll('.time-slot-container').forEach(slot => {
            const timeDisplay = slot.querySelector('.time-display')
            const nextButton = slot.querySelector('.next-button')

            // Reset time display
            timeDisplay.classList.remove('bg-gray-700', 'text-white', 'border-gray-700')
            timeDisplay.classList.add('border-blue-200', 'text-blue-600')

            // Hide next button
            if (nextButton) {
              nextButton.classList.add('hidden')
            }
          })

          // Update selected slot
          const timeDisplay = container.querySelector('.time-display')
          const nextButton = container.querySelector('.next-button')

          timeDisplay.classList.remove('border-blue-200', 'text-blue-600', 'hover:border-blue-500', 'hover:bg-blue-50')
          timeDisplay.classList.add('bg-gray-700', 'text-white', 'border-gray-700')

          if (nextButton) {
            nextButton.classList.remove('hidden')
          }

          // Store selected time
          this.selectedDateTime = time
        }

        showDetails(event) {
          event.preventDefault()

          if (!this.selectedDateTime) {
            alert('Por favor selecciona una fecha y hora')
            return
          }

          // Set the hidden field value
          if (this.hasStartTimeFieldTarget) {
            this.startTimeFieldTarget.value = this.selectedDateTime
          }

          // Hide/show steps
          if (this.hasDateStepTarget) this.dateStepTarget.classList.add('hidden')
          if (this.hasDetailsStepTarget) this.detailsStepTarget.classList.remove('hidden')

          window.scrollTo({ top: 0, behavior: 'smooth' })
        }

        goBack(event) {
          event.preventDefault()
          if (this.hasDateStepTarget) this.dateStepTarget.classList.remove('hidden')
          if (this.hasDetailsStepTarget) this.detailsStepTarget.classList.add('hidden')
          window.scrollTo({ top: 0, behavior: 'smooth' })
        }

        formatDate(dateString) {
          const date = new Date(dateString + 'T12:00:00')
          const days = ['domingo', 'lunes', 'martes', 'miércoles', 'jueves', 'viernes', 'sábado']
          const months = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre']
          return `${days[date.getDay()]}, ${date.getDate()} de ${months[date.getMonth()]}`
        }
      })
    })()
  </script>
<% end %>

<div class="px-4 mx-auto max-w-6xl sm:px-6 lg:px-8" data-controller="booking">
  <!-- Step 1: Date & Time Selection -->
  <div data-booking-target="dateStep">
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-5">
      <!-- Left: Event Info -->
      <div class="lg:col-span-2">
        <div class="sticky top-6">
          <%= link_to member_booking_path(@organization.slug, @member.booking_slug),
                     class: "text-sm text-blue-600 hover:text-blue-800 flex items-center mb-4" do %>
            <svg class="mr-1 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
            Volver
          <% end %>

          <h1 class="mb-2 text-xl font-bold text-gray-900">
            <%= @member.full_name %>
          </h1>

          <h2 class="mb-4 text-2xl font-bold text-gray-900">
            <%= @event_type.title %>
          </h2>

          <div class="space-y-3 text-sm text-gray-600">
            <div class="flex items-center">
              <svg class="mr-2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <%= @event_type.duration_minutes %> min
            </div>

            <% if @event_type.location_type.present? %>
              <div class="flex items-center">
                <svg class="mr-2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path>
                </svg>
                <%= @event_type.location_type.titleize %>
              </div>
            <% end %>

            <!-- Price - Prominent -->
            <% if @event_type.price_cents > 0 %>
              <div class="flex items-center pt-2 border-t">
                <svg class="mr-2 w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span class="text-2xl font-bold text-blue-600"><%= format_price(@event_type.price_cents, @event_type.price_currency) %></span>
              </div>
            <% else %>
              <div class="flex items-center pt-2 border-t">
                <span class="px-3 py-1 text-sm font-bold text-green-700 bg-green-100 rounded-full">FREE</span>
              </div>
            <% end %>
          </div>

          <% if @event_type.description.present? %>
            <p class="mt-4 text-sm text-gray-700">
              <%= @event_type.description %>
            </p>
          <% end %>
        </div>
      </div>

      <!-- Right: Calendar & Time Selection -->
      <div class="lg:col-span-3">
        <div class="p-6 bg-white rounded-lg shadow-sm">
          <h3 class="mb-4 text-lg font-semibold text-gray-900">
            <%= t('scheduling.bookings.new.select_datetime') %>
          </h3>

          <div data-booking-target="calendarGrid" class="grid grid-cols-1 gap-6">
            <!-- Left: Calendar -->
            <div class="w-full" style="max-width: 310px;">
              <%= render partial: 'calendar', locals: {
                available_dates: @available_dates,
                controller_name: 'booking'
              } %>

              <!-- Timezone Selector -->
              <div class="pt-4 mt-4 border-t">
                <label class="block mb-2 text-xs font-medium text-gray-700">
                  <%= t('scheduling.bookings.new.timezone') %>
                </label>
                <div class="relative">
                  <div class="flex items-center">
                    <svg class="mr-2 w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <select class="flex-1 p-0 text-sm text-gray-700 bg-transparent border-0 cursor-pointer focus:ring-0">
                      <option selected><%= @event_type.member.team.location.timezone %></option>
                    </select>
                  </div>
                </div>
              </div>
            </div>

            <!-- Right: Time Slots -->
            <div class="hidden flex-1" data-booking-target="timeSlotsColumn">
              <!-- Selected Date Display -->
              <div class="mb-3">
                <p class="text-sm font-semibold text-gray-900" data-booking-target="selectedDate"></p>
              </div>

              <!-- Time Slots -->
              <div data-booking-target="timeSlots" class="hidden overflow-y-auto pr-2 space-y-2 max-h-96">
                <!-- Time slots will be loaded here via Stimulus -->
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Step 2: User Details Form -->
  <div data-booking-target="detailsStep" class="hidden">
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-5">
      <!-- Left: Event Summary -->
      <div class="lg:col-span-2">
        <div class="sticky top-6">
          <button type="button"
                  data-action="click->booking#goBack"
                  class="flex items-center mb-4 text-sm text-blue-600 hover:text-blue-800">
            <svg class="mr-1 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
            <%= t('scheduling.bookings.new.back') %>
          </button>

          <h1 class="mb-2 text-xl font-bold text-gray-900">
            <%= @member.full_name %>
          </h1>

          <h2 class="mb-4 text-2xl font-bold text-gray-900">
            <%= @event_type.title %>
          </h2>

          <div class="p-4 space-y-3 text-sm bg-gray-50 rounded-lg">
            <div class="flex items-start">
              <svg class="mt-0.5 mr-2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
              </svg>
              <div>
                <p class="font-medium text-gray-700" data-booking-target="selectedDate"></p>
              </div>
            </div>

            <div class="flex items-center">
              <svg class="mr-2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <%= @event_type.duration_minutes %> minutos
            </div>

            <div class="flex items-center">
              <svg class="mr-2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <%= @event_type.member.team.location.timezone %>
            </div>

            <!-- Price -->
            <% if @event_type.price_cents > 0 %>
              <div class="flex items-center pt-2 border-t border-gray-200">
                <svg class="mr-2 w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span class="text-xl font-bold text-blue-600"><%= format_price(@event_type.price_cents, @event_type.price_currency) %></span>
              </div>
            <% else %>
              <div class="flex items-center pt-2 border-t border-gray-200">
                <span class="px-3 py-1 text-xs font-bold text-green-700 bg-green-100 rounded-full">FREE</span>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Right: Details Form -->
      <div class="lg:col-span-3">
        <div class="p-6 bg-white rounded-lg shadow-sm">
          <h3 class="mb-6 text-lg font-semibold text-gray-900">
            <%= t('scheduling.bookings.new.enter_details') %>
          </h3>

          <%= form_with model: @booking,
                       url: create_booking_path(@organization.slug, @member.booking_slug, @event_type.slug),
                       local: true,
                       class: "space-y-4" do |f| %>

            <%= f.hidden_field :start_time, data: { booking_target: "startTimeField" } %>
            <%= f.hidden_field :timezone, value: @event_type.member.team.location.timezone %>

            <% if @booking.errors.any? %>
              <div class="p-4 bg-red-50 rounded-lg border border-red-200">
                <h4 class="mb-2 font-semibold text-red-800">
                  <%= pluralize(@booking.errors.count, "error") %>:
                </h4>
                <ul class="text-sm list-disc list-inside text-red-700">
                  <% @booking.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <div>
              <label class="block mb-2 text-sm font-bold text-gray-900">
                <%= t('scheduling.forms.first_name') %> <%= t('scheduling.forms.required') %>
              </label>
              <%= text_field_tag 'booking[client_first_name]',
                                params.dig(:booking, :client_first_name),
                                required: true,
                                class: "w-full px-4 py-3 text-base rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
            </div>

            <div>
              <label class="block mb-2 text-sm font-bold text-gray-900">
                <%= t('scheduling.forms.last_name') %> <%= t('scheduling.forms.required') %>
              </label>
              <%= text_field_tag 'booking[client_last_name]',
                                params.dig(:booking, :client_last_name),
                                required: true,
                                class: "w-full px-4 py-3 text-base rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
            </div>

            <div>
              <label class="block mb-2 text-sm font-bold text-gray-900">
                <%= t('scheduling.forms.email') %> <%= t('scheduling.forms.required') %>
              </label>
              <%= email_field_tag 'booking[client_email]',
                                 params.dig(:booking, :client_email),
                                 required: true,
                                 class: "w-full px-4 py-3 text-base rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
            </div>

            <div>
              <label class="block mb-2 text-sm font-bold text-gray-900">
                <%= t('scheduling.forms.phone') %>
              </label>
              <%= telephone_field_tag 'booking[client_phone]',
                                     params.dig(:booking, :client_phone),
                                     class: "w-full px-4 py-3 text-base rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
            </div>

            <!-- Custom Questions -->
            <% if @booking_questions.any? %>
              <div class="pt-4 mt-6 border-t">
                <% @booking_questions.each do |question| %>
                  <div class="mb-4">
                    <label class="block mb-2 text-sm font-bold text-gray-900">
                      <%= question.label %>
                      <% if question.required? %>
                        <span class="text-red-500">*</span>
                      <% end %>
                    </label>
                    <% if question.help_text.present? %>
                      <p class="mb-2 text-sm text-gray-600"><%= question.help_text %></p>
                    <% end %>
                    <%= render partial: 'question_field', locals: { question: question } %>
                  </div>
                <% end %>
              </div>
            <% end %>

            <!-- Notes -->
            <div class="pt-4 border-t">
              <label class="block mb-2 text-sm font-bold text-gray-900">
                <%= t('scheduling.forms.notes') %>
              </label>
              <%= f.text_area :notes,
                            rows: 3,
                            placeholder: t('scheduling.forms.notes_placeholder'),
                            class: "w-full px-4 py-3 text-base rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
            </div>

            <!-- Payment Section (if required) -->
            <% if @event_type.requires_payment && @event_type.payment_required_to_book %>
              <div class="pt-4 mt-4 border-t"
                   data-controller="scheduling--culqi-payment"
                   data-scheduling--culqi-payment-amount-value="<%= @event_type.price_cents %>"
                   data-scheduling--culqi-payment-currency-value="<%= @event_type.price_currency %>"
                   data-scheduling--culqi-payment-description-value="<%= @event_type.title %> - <%= @member.full_name %>"
                   data-scheduling--culqi-payment-public-key-value="<%= Culqi.public_key %>">

                <h4 class="mb-3 text-sm font-bold text-gray-900">
                  <%= t('scheduling.payments.payment_required') %>
                </h4>

                <div class="p-4 mb-4 bg-blue-50 rounded-lg border border-blue-200">
                  <div class="flex items-center justify-between">
                    <div class="flex items-center">
                      <svg class="mr-2 w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path>
                      </svg>
                      <span class="text-sm font-medium text-blue-900"><%= t('scheduling.payments.total') %></span>
                    </div>
                    <span class="text-lg font-bold text-blue-900">
                      <%= format_price(@event_type.price_cents, @event_type.price_currency) %>
                    </span>
                  </div>
                </div>

                <!-- Message target for payment status -->
                <div data-scheduling--culqi-payment-target="message" class="hidden mb-4"></div>

                <!-- Culqi Payment Button -->
                <button type="button"
                        data-scheduling--culqi-payment-target="payButton"
                        data-action="click->scheduling--culqi-payment#pay"
                        class="w-full px-6 py-3 bg-blue-600 text-white font-semibold rounded-md hover:bg-blue-700 transition-colors flex items-center justify-center">
                  <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path>
                  </svg>
                  <%= t('scheduling.payments.pay_now') %> <%= format_price(@event_type.price_cents, @event_type.price_currency) %>
                </button>

                <p class="mt-2 text-xs text-center text-gray-500">
                  <%= t('scheduling.payments.secure_payment') %>
                </p>
              </div>
            <% else %>
              <!-- Submit (Free or Optional Payment) -->
              <div class="pt-4">
                <%= f.submit t('scheduling.bookings.new.confirm_booking'),
                           class: "w-full px-6 py-3 bg-blue-600 text-white font-semibold rounded-md hover:bg-blue-700 transition-colors cursor-pointer" %>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
