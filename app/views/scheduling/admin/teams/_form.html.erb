<%= form_with model: [:admin, @team], local: true, class: "space-y-6" do |f| %>
  <% if @team.errors.any? %>
    <div class="p-4 bg-red-50 border-l-4 border-red-400">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="w-5 h-5 text-red-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
          </svg>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800">
            <%= t('scheduling.admin.teams.form.errors_found', count: @team.errors.count) %>
          </h3>
          <div class="mt-2 text-sm text-red-700">
            <ul class="pl-5 list-disc">
              <% @team.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <div class="bg-white rounded-lg shadow">
    <div class="px-6 py-4 border-b border-gray-200">
      <h3 class="text-lg font-medium text-gray-900"><%= t('scheduling.admin.teams.form.basic_info') %></h3>
    </div>
    <div class="px-6 py-4 space-y-4">
      <div>
        <%= f.label :name, t('scheduling.admin.teams.form.name_label'), class: "block text-sm font-medium text-gray-700" %>
        <%= f.text_field :name,
            class: "block mt-1 w-full px-3 py-2 rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
      </div>

      <div>
        <%= f.label :location_id, t('scheduling.admin.teams.form.location_label'), class: "block text-sm font-medium text-gray-700" %>
        <%= f.select :location_id,
            options_for_select(@locations.map { |l| [l.name, l.id] }, @team.location_id),
            { include_blank: t('scheduling.admin.teams.form.select_location') },
            class: "block mt-1 w-full px-3 py-2 rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
      </div>

      <div>
        <%= f.label :slug, t('scheduling.admin.teams.form.slug_label'), class: "block text-sm font-medium text-gray-700" %>
        <%= f.text_field :slug,
            placeholder: t('scheduling.admin.teams.form.slug_placeholder'),
            class: "block mt-1 w-full px-3 py-2 rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
        <p class="mt-1 text-sm text-gray-500"><%= t('scheduling.admin.teams.form.slug_help') %></p>
      </div>

      <div>
        <%= f.label :color, t('scheduling.admin.teams.form.color_label'), class: "block text-sm font-medium text-gray-700" %>
        <div class="flex gap-2 mt-1">
          <%= f.color_field :color,
              class: "h-10 w-20 rounded-md border-gray-300 shadow-sm" %>
          <%= f.text_field :color,
              placeholder: "#3B82F6",
              class: "block flex-1 px-3 py-2 rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
        </div>
        <p class="mt-1 text-sm text-gray-500"><%= t('scheduling.admin.teams.form.color_help') %></p>
      </div>

      <div>
        <%= f.label :description, t('scheduling.admin.teams.form.description_label'), class: "block text-sm font-medium text-gray-700" %>
        <%= f.text_area :description,
            rows: 3,
            class: "block mt-1 w-full px-3 py-2 rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
      </div>

      <div class="flex items-start">
        <div class="flex items-center h-5">
          <%= f.check_box :active, class: "w-4 h-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500" %>
        </div>
        <div class="ml-3">
          <%= f.label :active, t('scheduling.admin.teams.form.active_label'), class: "text-sm font-medium text-gray-700" %>
          <p class="text-sm text-gray-500"><%= t('scheduling.admin.teams.form.active_help') %></p>
        </div>
      </div>
    </div>
  </div>

  <div class="flex items-center justify-end gap-3">
    <%= link_to t('scheduling.admin.teams.form.cancel_button'),
        @team.persisted? ? admin_team_path(@team) : admin_teams_path,
        class: "px-4 py-2 text-sm font-medium text-gray-700 bg-white rounded-md border border-gray-300 hover:bg-gray-50" %>
    <%= f.submit t('scheduling.admin.teams.form.submit_button'),
        class: "px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-md hover:bg-blue-700" %>
  </div>
<% end %>
