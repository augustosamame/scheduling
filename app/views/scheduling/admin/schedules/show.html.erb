<% content_for :title, @schedule.name %>

<div class="mb-6">
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-2xl font-bold text-gray-900"><%= @schedule.name %></h2>
      <p class="mt-1 text-sm text-gray-500">
        <%= @schedule.member.full_name %> • <%= @schedule.timezone %>
        <% if @schedule.is_default %>
          <span class="inline-flex items-center px-2 py-0.5 ml-2 text-xs font-medium text-green-800 bg-green-100 rounded">
            <%= t('scheduling.admin.schedules.show.default_schedule') %>
          </span>
        <% end %>
      </p>
    </div>
    <div class="flex gap-2">
      <%= link_to t('scheduling.admin.schedules.show.edit'), edit_admin_schedule_path(@schedule), class: "px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-md hover:bg-blue-700" %>
      <%= link_to "← #{t('scheduling.admin.schedules.show.back_to_list')}", admin_schedules_path, class: "px-4 py-2 text-sm font-medium text-gray-700 bg-white rounded-md border border-gray-300 hover:bg-gray-50" %>
    </div>
  </div>
</div>

<!-- Weekly Availability -->
<div class="mb-6 overflow-hidden bg-white rounded-lg shadow">
  <div class="px-6 py-4 border-b border-gray-200">
    <h3 class="text-lg font-medium text-gray-900"><%= t('scheduling.admin.schedules.show.weekly_availability') %></h3>
    <p class="mt-1 text-sm text-gray-500">
      <%= t('scheduling.admin.schedules.show.recurring_hours') %>
      <span class="ml-2 text-xs font-semibold text-gray-600">(<%= @schedule.timezone %>)</span>
    </p>
  </div>
  <div class="px-6 py-4">
    <% if @schedule.availabilities.any? %>
      <div class="space-y-4">
        <% (0..6).each do |day| %>
          <% day_slots = @schedule.availabilities.where(day_of_week: day).order(:start_time) %>
          <div class="flex items-start gap-4">
            <div class="w-32">
              <span class="text-sm font-medium <%= day_slots.any? ? 'text-gray-900' : 'text-gray-400' %>">
                <%= t("scheduling.days.full.#{day}") %>
              </span>
            </div>
            <div class="flex-1">
              <% if day_slots.any? %>
                <div class="flex flex-wrap gap-2">
                  <% day_slots.each do |slot| %>
                    <span class="inline-flex items-center px-3 py-1 text-sm font-medium text-blue-800 bg-blue-100 rounded-md">
                      <%= slot.start_time.strftime('%I:%M %p') %> - <%= slot.end_time.strftime('%I:%M %p') %>
                    </span>
                  <% end %>
                </div>
              <% else %>
                <span class="text-sm text-gray-400"><%= t('scheduling.admin.schedules.show.unavailable') %></span>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-gray-500"><%= t('scheduling.admin.schedules.show.no_availability') %></p>
    <% end %>
  </div>
</div>

<!-- Schedule Settings -->
<div class="overflow-hidden bg-white rounded-lg shadow">
  <div class="px-6 py-4 border-b border-gray-200">
    <h3 class="text-lg font-medium text-gray-900"><%= t('scheduling.admin.schedules.show.settings') %></h3>
  </div>
  <div class="px-6 py-4">
    <dl class="grid grid-cols-1 gap-x-4 gap-y-6 sm:grid-cols-2">
      <div>
        <dt class="text-sm font-medium text-gray-500"><%= t('scheduling.admin.schedules.show.schedule_name') %></dt>
        <dd class="mt-1 text-sm text-gray-900"><%= @schedule.name %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-gray-500"><%= t('scheduling.admin.schedules.show.timezone') %></dt>
        <dd class="mt-1 text-sm text-gray-900"><%= @schedule.timezone %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-gray-500"><%= t('scheduling.admin.schedules.show.member') %></dt>
        <dd class="mt-1 text-sm text-gray-900"><%= @schedule.member.full_name %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-gray-500"><%= t('scheduling.admin.schedules.show.default_schedule') %></dt>
        <dd class="mt-1 text-sm text-gray-900">
          <% if @schedule.is_default %>
            <span class="inline-flex items-center px-2.5 py-0.5 text-xs font-medium text-green-800 bg-green-100 rounded-full">
              <%= t('scheduling.admin.schedules.show.yes') %>
            </span>
          <% else %>
            <span class="text-gray-500"><%= t('scheduling.admin.schedules.show.no') %></span>
          <% end %>
        </dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-gray-500"><%= t('scheduling.admin.schedules.show.created_at') %></dt>
        <dd class="mt-1 text-sm text-gray-900"><%= l(@schedule.created_at, format: :long) %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-gray-500"><%= t('scheduling.admin.schedules.show.updated_at') %></dt>
        <dd class="mt-1 text-sm text-gray-900"><%= l(@schedule.updated_at, format: :long) %></dd>
      </div>
    </dl>
  </div>
</div>

<!-- Danger Zone -->
<div class="mt-6 overflow-hidden bg-white border-2 border-red-200 rounded-lg shadow">
  <div class="px-6 py-4 bg-red-50 border-b border-red-200">
    <h3 class="text-lg font-medium text-red-900"><%= t('scheduling.admin.schedules.show.danger_zone') %></h3>
  </div>
  <div class="px-6 py-4">
    <div class="flex items-center justify-between">
      <div>
        <h4 class="text-sm font-medium text-gray-900"><%= t('scheduling.admin.schedules.show.delete_schedule') %></h4>
        <p class="mt-1 text-sm text-gray-500"><%= t('scheduling.admin.schedules.show.delete_warning') %></p>
      </div>
      <%= button_to t('scheduling.admin.schedules.show.delete_button'),
          admin_schedule_path(@schedule),
          method: :delete,
          data: { confirm: t('scheduling.admin.schedules.show.delete_confirmation') },
          class: "px-4 py-2 text-sm font-medium text-white bg-red-600 rounded-md hover:bg-red-700" %>
    </div>
  </div>
</div>
