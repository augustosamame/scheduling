<% content_for :title, t('scheduling.admin.event_types.index.title') %>

<div class="mb-6">
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-2xl font-bold text-gray-900"><%= t('scheduling.admin.event_types.index.title') %></h2>
      <p class="mt-1 text-sm text-gray-500">Manage your appointment types and availability</p>
    </div>
    <%= link_to new_admin_event_type_path, class: "inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-md hover:bg-blue-700" do %>
      <svg class="mr-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
      </svg>
      <%= t('scheduling.admin.event_types.index.create_new') %>
    <% end %>
  </div>
</div>

<!-- Event Types Grid -->
<div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
  <% @event_types.each do |event_type| %>
    <div class="overflow-hidden bg-white rounded-lg shadow hover:shadow-md transition-shadow">
      <!-- Header with color indicator -->
      <div class="h-2 <%= event_type.active? ? 'bg-green-500' : 'bg-gray-300' %>" style="<%= event_type.color.present? ? "background-color: #{event_type.color}" : '' %>"></div>

      <div class="p-5">
        <!-- Title and Status -->
        <div class="flex items-start justify-between mb-3">
          <div class="flex-1">
            <h3 class="text-lg font-semibold text-gray-900"><%= event_type.title %></h3>
            <p class="text-xs text-gray-500">/<%= event_type.slug %></p>
          </div>
          <span class="inline-flex px-2 py-1 text-xs font-semibold leading-5 rounded-full <%= event_type.active? ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800' %>">
            <%= event_type.active? ? t('scheduling.admin.event_types.index.active') : t('scheduling.admin.event_types.index.inactive') %>
          </span>
        </div>

        <!-- Description -->
        <% if event_type.description.present? %>
        <p class="mb-4 text-sm text-gray-600 line-clamp-2"><%= event_type.description %></p>
        <% end %>

        <!-- Details Grid -->
        <div class="mb-4 space-y-2 text-sm">
          <!-- Duration -->
          <div class="flex items-center text-gray-600">
            <svg class="mr-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span><%= t('scheduling.admin.event_types.index.duration', minutes: event_type.duration_minutes) %></span>
          </div>

          <!-- Location Type -->
          <% if event_type.location_type.present? %>
          <div class="flex items-center text-gray-600">
            <svg class="mr-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            <span><%= event_type.location_type.titleize %></span>
          </div>
          <% end %>

          <!-- Price -->
          <% if event_type.requires_payment %>
          <div class="flex items-center text-gray-600">
            <svg class="mr-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span class="font-medium text-gray-900">
              <%= number_to_currency(event_type.price_cents / 100.0, unit: event_type.price_currency == 'PEN' ? 'S/. ' : '$', precision: 2) %>
            </span>
            <% if event_type.payment_required_to_book %>
              <span class="ml-1 text-xs text-red-600">(Required)</span>
            <% else %>
              <span class="ml-1 text-xs text-yellow-600">(Optional)</span>
            <% end %>
          </div>
          <% else %>
          <div class="flex items-center text-gray-600">
            <svg class="mr-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span><%= t('scheduling.admin.event_types.index.free') %></span>
          </div>
          <% end %>

          <!-- Member -->
          <div class="flex items-center text-gray-600">
            <svg class="mr-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
            </svg>
            <span><%= event_type.member.full_name %></span>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex space-x-2">
          <%= link_to admin_event_type_path(event_type), class: "flex-1 inline-flex items-center justify-center px-3 py-2 text-sm font-medium text-gray-700 bg-white rounded-md border border-gray-300 hover:bg-gray-50" do %>
            <svg class="mr-1 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
            </svg>
            <%= t('scheduling.admin.event_types.index.view_details') %>
          <% end %>
          <%= link_to edit_admin_event_type_path(event_type), class: "flex-1 inline-flex items-center justify-center px-3 py-2 text-sm font-medium text-white bg-blue-600 rounded-md hover:bg-blue-700" do %>
            <svg class="mr-1 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
            </svg>
            <%= t('scheduling.admin.event_types.index.edit') %>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>

<!-- Empty State -->
<% if @event_types.empty? %>
<div class="py-12 text-center bg-white rounded-lg shadow">
  <svg class="mx-auto w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
  </svg>
  <h3 class="mt-2 text-sm font-medium text-gray-900"><%= t('scheduling.admin.event_types.index.no_event_types') %></h3>
  <p class="mt-1 text-sm text-gray-500"><%= t('scheduling.admin.event_types.index.create_first') %></p>
  <div class="mt-6">
    <%= link_to new_admin_event_type_path, class: "inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-md hover:bg-blue-700" do %>
      <svg class="mr-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
      </svg>
      <%= t('scheduling.admin.event_types.index.create_new') %>
    <% end %>
  </div>
</div>
<% end %>

<!-- Pagination -->
<% if @event_types.any? %>
<div class="mt-6">
  <%= paginate @event_types if defined?(paginate) %>
</div>
<% end %>
