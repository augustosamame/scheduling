    <%= link_to "← #{t('scheduling.admin.event_types.edit.back_to_event_type')}", admin_event_type_path(@event_type), class: "px-4 py-2 text-sm font-medium text-gray-700 bg-white rounded-md border border-gray-300 hover:bg-gray-50" %>
