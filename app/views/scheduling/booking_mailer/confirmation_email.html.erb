<!DOCTYPE html>
<html>
<head>
  <meta content='text/html; charset=UTF-8' http-equiv='Content-Type' />
  <style>
    body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }
    .container { max-width: 600px; margin: 0 auto; padding: 20px; }
    .header { background: #3b82f6; color: white; padding: 30px; text-align: center; border-radius: 8px 8px 0 0; }
    .content { background: #f9fafb; padding: 30px; }
    .details { background: white; padding: 20px; border-radius: 8px; margin: 20px 0; }
    .detail-row { padding: 10px 0; border-bottom: 1px solid #e5e7eb; }
    .detail-row:last-child { border-bottom: none; }
    .label { font-weight: bold; color: #6b7280; font-size: 14px; }
    .value { color: #111827; margin-top: 5px; }
    .button { display: inline-block; background: #3b82f6; color: white; padding: 12px 24px; text-decoration: none; border-radius: 6px; margin: 10px 5px; }
    .button-secondary { background: #6b7280; }
    .footer { text-align: center; padding: 20px; color: #6b7280; font-size: 14px; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1><%= t('scheduling.mailers.confirmation.confirmed') %></h1>
    </div>

    <div class="content">
      <p><%= t('scheduling.mailers.confirmation.greeting', client_name: @client.full_name) %></p>

      <p><%= t('scheduling.mailers.confirmation.confirmed') %></p>

      <div class="details">
        <h2><%= t('scheduling.mailers.confirmation.details') %></h2>

        <div class="detail-row">
          <div class="label"><%= t('scheduling.mailers.confirmation.date') %></div>
          <div class="value"><%= l(@booking.start_time.in_time_zone(@booking.timezone), format: :long) %></div>
        </div>

        <div class="detail-row">
          <div class="label"><%= t('scheduling.mailers.confirmation.time') %></div>
          <div class="value">
            <%= @booking.start_time.in_time_zone(@booking.timezone).strftime('%I:%M %p') %> -
            <%= @booking.end_time.in_time_zone(@booking.timezone).strftime('%I:%M %p') %>
            (<%= @booking.timezone %>)
          </div>
        </div>

        <div class="detail-row">
          <div class="label"><%= t('scheduling.mailers.confirmation.duration') %></div>
          <div class="value"><%= @event_type.duration_minutes %> <%= t('scheduling.bookings.show.minutes') %></div>
        </div>

        <div class="detail-row">
          <div class="label"><%= t('scheduling.mailers.confirmation.with') %></div>
          <div class="value">
            <%= @member.full_name %>
            <% if @member.title.present? %><br><small><%= @member.title %></small><% end %>
          </div>
        </div>

        <% if @event_type.location_type.present? %>
          <div class="detail-row">
            <div class="label"><%= t('scheduling.mailers.confirmation.location') %></div>
            <div class="value"><%= @event_type.location_type.titleize %></div>
          </div>
        <% end %>

        <div class="detail-row">
          <div class="label"><%= t('scheduling.bookings.show.confirmation_code') %></div>
          <div class="value" style="font-family: monospace;"><%= @booking.uid %></div>
        </div>
      </div>

      <% if @booking.notes.present? %>
        <div class="details">
          <h3><%= t('scheduling.bookings.show.additional_notes') %></h3>
          <p><%= @booking.notes %></p>
        </div>
      <% end %>

      <% if @booking.booking_answers.any? %>
        <div class="details">
          <h3><%= t('scheduling.bookings.show.additional_information') %></h3>
          <% @booking.booking_answers.each do |answer| %>
            <div class="detail-row">
              <div class="label"><%= answer.booking_question.label %></div>
              <div class="value"><%= answer.answer %></div>
            </div>
          <% end %>
        </div>
      <% end %>

      <div style="text-align: center; margin: 30px 0;">
        <% if @booking.can_reschedule? %>
          <a href="<%= reschedule_booking_url(@booking.reschedule_token) %>" class="button button-secondary">
            <%= t('scheduling.mailers.confirmation.reschedule_link') %>
          </a>
        <% end %>

        <% if @booking.can_cancel? %>
          <a href="<%= cancel_booking_url(@booking.cancellation_token) %>" class="button button-secondary">
            <%= t('scheduling.mailers.confirmation.cancel_link') %>
          </a>
        <% end %>
      </div>

      <p style="font-size: 14px; color: #6b7280;">
        <% if @booking.event_type.allow_cancellation %>
          <%= t('scheduling.bookings.show.cancel_policy', hours: @booking.event_type.cancellation_policy_hours) %>
        <% end %>
        <% if @booking.event_type.allow_rescheduling %>
          <%= t('scheduling.bookings.show.reschedule_policy', hours: @booking.event_type.rescheduling_policy_hours) %>
        <% end %>
      </p>
    </div>

    <div class="footer">
      <p><%= Scheduling.configuration.company_name || 'Scheduling' %></p>
    </div>
  </div>
</body>
</html>
